# No package runs arbitrary code at install time. Inherited from nullroute,
# where it was a security posture for a signing device. Here it is a
# reproducibility posture: the endurance number this repository publishes has to
# be a function of the source, and a postinstall script is a build input nobody
# reads.
ignore-scripts=true

# Exact versions only. A caret range means two `npm install` runs a week apart
# can produce different code with the same lockfile intent. A physics model
# whose answer depends on when you installed it is not a physics model.
save-exact=true

audit=true
fund=false

# `npm ci` is the only supported install path. See the Makefile.
engine-strict=true

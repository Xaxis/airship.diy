.idea
*.iml

# Secrets: never commit
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
.next/
.next-dev/
out/

# Local scratch
tmp/
.vercel

# OS
.DS_Store

# Generated reports. Committing these would let a stale pass ship.
uncertainty-report.json
validation-report.json
test-report.json
*.tsbuildinfo

# Scratch scripts. They belong in the session scratchpad, not the tree, and
# `git add -A` will otherwise sweep them in and fail lint on the next run.
/chk*.mjs
/scratch*.mjs
/_chk*.mjs
/_*.mjs
/.scratch*.mjs
/.verify*.mjs
/*.py

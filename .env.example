# airship.diy environment.
#
# This file documents what .env may contain. Never commit .env itself.
#
# Nothing in packages/ reads environment variables. The model must be a function
# of the source: a physics result that depends on ambient environment is a
# physics result nobody can reproduce, including you, next week.

# --- Site ---
# Canonical URLs and Open Graph metadata. Vercel sets this per environment;
# locally it is the dev server.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Provisioning ---
# Account-level Vercel token, used by the CLI for deploys. Not read at runtime
# and not set as a project environment variable in Vercel.
VERCEL_TOKEN=
